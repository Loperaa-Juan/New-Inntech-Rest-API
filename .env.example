DATABASE_URL="postgresql+psycopg://<usuario>:<contraseña>@127.0.0.1:55432/<nombre_db>"

POSTGRES_USER=<usuario>
POSTGRES_PASSWORD=<contraseña>
POSTGRES_DB=<nombre_db>

# Autenticación (JWT)
# Genera la clave con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<clave_secreta>
JWT_EXPIRE_MINUTES=30
ADMIN_USERNAME=<usuario_admin>
ADMIN_PASSWORD=<contraseña_admin>
